{
  "name": "dexcom-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Dexcom CGM - assistive intelligence for Type 1 diabetics",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "oauth": "tsx src/oauth-helper.ts",
    "oauth:manual": "tsx src/manual-oauth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cykj40/dexcom-mcp-server.git"
  },
  "keywords": [
    "dexcom",
    "cgm",
    "diabetes",
    "mcp",
    "glucose-monitoring"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cykj40/dexcom-mcp-server/issues"
  },
  "homepage": "https://github.com/cykj40/dexcom-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.2.4",
    "openid-client": "^6.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.1.0",
    "@vitest/ui": "^4.0.18",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
