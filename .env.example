# Dexcom Developer API Configuration (Required)
# Get these from https://developer.dexcom.com/
DEXCOM_CLIENT_ID=your_client_id_here
DEXCOM_CLIENT_SECRET=your_client_secret_here
DEXCOM_REDIRECT_URI=http://localhost:3000/callback
DEXCOM_ACCESS_TOKEN=your_access_token_here
DEXCOM_REFRESH_TOKEN=your_refresh_token_here

# Dexcom Share API Configuration (Optional - Fallback Only)
# These are your Dexcom Share credentials
DEXCOM_SHARE_USERNAME=your_share_username
DEXCOM_SHARE_PASSWORD=your_share_password

# Database Configuration
DB_PATH=./data/dexcom.db

# API Environment
# Options: "production" or "sandbox"
DEXCOM_API_ENV=production
