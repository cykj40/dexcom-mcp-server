# Dexcom Developer API Configuration (Required)
# Get client credentials from https://developer.dexcom.com/

DEXCOM_CLIENT_ID=your_client_id_here
DEXCOM_CLIENT_SECRET=your_client_secret_here
DEXCOM_REDIRECT_URI=http://localhost:3000/callback

# Optional one-time OAuth bootstrap tokens.
# Turso is the source of truth; only set these when Turso has no tokens.
# DEXCOM_ACCESS_TOKEN=your_access_token_here
# DEXCOM_REFRESH_TOKEN=your_refresh_token_here

# Dexcom Share API Configuration (Optional - Fallback Only)
# These are your Dexcom Share credentials
DEXCOM_SHARE_USERNAME=your_share_username
DEXCOM_SHARE_PASSWORD=your_share_password

# Turso Database Configuration (Required)
# Create a database at https://turso.tech/
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Legacy HTTP bearer (required only before 2026-10-04T00:00:00Z)
# Accepted only at /mcp until that fixed cutoff; never exchanged or reissued.
# Generate a strong random token: openssl rand -hex 32
MCP_AUTH_TOKEN=your-secret-bearer-token

# OAuth 2.0 credentials for Claude.ai MCP connector
# Generate client secret: openssl rand -hex 16
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
# Required for HTTP: exact callback URLs, comma-separated. Every entry must be a URL.
OAUTH_ALLOWED_REDIRECT_URIS=https://your-client.example.invalid/callback,https://your-other-client.example.invalid/callback
# Required for HTTP: canonical HTTPS origin, with no trailing slash.
OAUTH_ISSUER_URL=https://your-server.example.invalid
# SHA-256 hex digest of a SEPARATE random 32-byte, base64url-encoded owner key.
# Keep the raw key in your password manager; enter it only on the approval page.
# See SECURITY-REMEDIATION-NOTES.txt for the local generation command.
OAUTH_OWNER_APPROVAL_KEY_SHA256=replace_with_64_lowercase_hex_characters

# Transport mode
# Options: "stdio" (default, for Claude Desktop) | "http" (for remote access)
TRANSPORT=stdio
PORT=3000

# API Environment
# Options: "production" or "sandbox"
DEXCOM_API_ENV=production

# IANA timezone used to bucket days for daily summaries and charts. Defaults to UTC.
# SERVER_TIMEZONE=America/New_York
